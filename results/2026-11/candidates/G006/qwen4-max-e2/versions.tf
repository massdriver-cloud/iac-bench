terraform {
  required_version = ">= 1.6.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

provider "azurerm" {
  features {}

  # App teams' subscriptions may not grant provider-registration rights;
  # the platform team pre-registers the providers we need.
  resource_provider_registrations = "none"
}
