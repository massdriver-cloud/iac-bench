# =============================================================================
# Required inputs: the things only the owning service team knows. Everything
# else has a production-grade default that the platform team owns.
# =============================================================================

variable "service_name" {
  description = "Name of the service that owns this database (e.g. \"checkout\"). Prefixes every resource the module creates."
  type        = string

  validation {
    condition     = length(var.service_name) <= 24 && can(regex("^[a-z][a-z0-9]*(-[a-z0-9]+)*$", var.service_name))
    error_message = "service_name must be lowercase alphanumeric (single hyphens between words allowed), start with a letter, and be at most 24 characters."
  }
}

variable "environment" {
  description = "Deployment environment, \"staging\" or \"prod\". The module looks up the environment's VPC by its Name tag apps-<environment> unless vpc_name is given."
  type        = string

  validation {
    condition     = length(var.environment) <= 16 && can(regex("^[a-z][a-z0-9]*$", var.environment))
    error_message = "environment must be lowercase alphanumeric starting with a letter, e.g. \"staging\" or \"prod\"."
  }
}

variable "primary_region" {
  description = "AWS region hosting the read-write cluster during normal operation, e.g. \"us-east-1\"."
  type        = string
}

variable "secondary_region" {
  description = "AWS region hosting the warm standby cluster that takes over during a regional outage, e.g. \"us-west-2\"."
  type        = string

  validation {
    condition     = var.secondary_region != var.primary_region
    error_message = "secondary_region must differ from primary_region: the standby must live in a different region to survive a regional outage."
  }
}

# =============================================================================
# Optional inputs: sensible production defaults. Override only with a reason.
# =============================================================================

variable "vpc_name" {
  description = "Value of the Name tag of the environment's VPC (same name in both regions). Defaults to apps-<environment>, i.e. apps-staging / apps-prod."
  type        = string
  default     = null
}

variable "engine_version" {
  description = "Aurora PostgreSQL engine version. Major/minor upgrades are done by bumping this and re-applying; keep it on an AWS-supported version."
  type        = string
  default     = "16.4"
}

variable "instance_class" {
  description = "Instance class for every cluster instance in both regions, e.g. \"db.r6g.large\"."
  type        = string
  default     = "db.r6g.large"
}

variable "primary_instance_count" {
  description = "Number of instances in the primary region: one writer plus (n - 1) readers, placed in distinct AZs. Production minimum is 2 so an AZ/instance failure fails over within the region."
  type        = number
  default     = 2

  validation {
    condition     = var.primary_instance_count >= 2
    error_message = "A production cluster needs at least 2 instances in the primary region so failures can be absorbed within the region."
  }
}

variable "secondary_instance_count" {
  description = "Number of instances in the secondary region. They serve local reads during normal operation and become the writer after a regional failover."
  type        = number
  default     = 1

  validation {
    condition     = var.secondary_instance_count >= 1
    error_message = "The secondary region needs at least one instance: it is the regional failover target."
  }
}

variable "database_name" {
  description = "Initial database created inside the cluster. Defaults to service_name with hyphens replaced by underscores."
  type        = string
  default     = null
}

variable "master_username" {
  description = "Master (superuser) username. The password is generated by the module and stored in Secrets Manager in both regions; it is never exposed in outputs."
  type        = string
  default     = "postgres"

  validation {
    condition     = can(regex("^[a-zA-Z][a-zA-Z0-9]{0,62}$", var.master_username))
    error_message = "master_username must start with a letter and contain only letters and digits."
  }
}

variable "backup_retention_period" {
  description = "Days of point-in-time recovery retention (1-35). Automated backups live in the primary region."
  type        = number
  default     = 14

  validation {
    condition     = var.backup_retention_period >= 1 && var.backup_retention_period <= 35
    error_message = "backup_retention_period must be between 1 and 35 days."
  }
}

variable "preferred_backup_window" {
  description = "Daily UTC window for automated backups, hh24:mi-hh24:mi."
  type        = string
  default     = "03:00-04:00"
}

variable "preferred_maintenance_window" {
  description = "Weekly UTC window for maintenance (incl. minor-version patching), ddd:hh24:mi-ddd:hh24:mi."
  type        = string
  default     = "sun:05:00-sun:06:00"
}

variable "log_retention_in_days" {
  description = "CloudWatch Logs retention for the exported PostgreSQL logs."
  type        = number
  default     = 90
}

variable "deletion_protection" {
  description = "RDS deletion protection on the clusters and the global cluster. Leave on for production."
  type        = bool
  default     = true
}

variable "additional_ingress_cidr_blocks" {
  description = "Extra CIDR blocks allowed to reach PostgreSQL on top of the VPC CIDR (e.g. if EKS pods use a secondary CIDR range)."
  type        = list(string)
  default     = []
}

variable "extra_tags" {
  description = "Extra tags merged onto every resource in addition to the module's standard tags."
  type        = map(string)
  default     = {}
}
