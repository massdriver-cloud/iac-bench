# The master password is generated by the module and stored in Secrets
# Manager in BOTH regions: if a region fails, the surviving region has the
# credentials it needs to keep operating the (promoted) database. Both secrets
# are fed from the same generated password, so they never diverge.
#
# Services on EKS do not use these credentials - they authenticate with IAM -
# but operators and migration tooling do.

resource "random_password" "master" {
  length           = 32
  special          = true
  override_special = "!#$%*()-_=+[]{}:?"
}

locals {
  master_secret = {
    engine   = local.engine
    port     = var.port
    dbname   = local.database_name
    username = var.master_username
    password = random_password.master.result
  }
}

resource "aws_secretsmanager_secret" "master_primary" {
  name                    = "${local.name}-master"
  description             = "Master credentials for the ${local.name} Aurora PostgreSQL database (also available in ${var.secondary_region})."
  recovery_window_in_days = local.secret_recovery_window
}

resource "aws_secretsmanager_secret" "master_secondary" {
  provider                = aws.secondary
  name                    = "${local.name}-master"
  description             = "Master credentials for the ${local.name} Aurora PostgreSQL database (also available in ${var.primary_region})."
  recovery_window_in_days = local.secret_recovery_window
}

resource "aws_secretsmanager_secret_version" "master_primary" {
  secret_id     = aws_secretsmanager_secret.master_primary.id
  secret_string = jsonencode(local.master_secret)
}

resource "aws_secretsmanager_secret_version" "master_secondary" {
  provider      = aws.secondary
  secret_id     = aws_secretsmanager_secret.master_secondary.id
  secret_string = jsonencode(local.master_secret)
}
