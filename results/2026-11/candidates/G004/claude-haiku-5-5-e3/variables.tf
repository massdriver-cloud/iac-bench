variable "service_name" {
  type        = string
  description = "Name of the owning service, e.g. \"payments-ledger\". Used in every resource name. Lowercase letters, digits and hyphens, 3-32 characters."

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{1,30}[a-z0-9]$", var.service_name))
    error_message = "service_name must be 3-32 characters: lowercase letters, digits and hyphens, starting with a letter and not ending with a hyphen."
  }
}

variable "environment" {
  type        = string
  description = "Environment. Selects the apps-<environment> VPC that the network team owns in each region."

  validation {
    condition     = contains(["staging", "prod"], var.environment)
    error_message = "environment must be \"staging\" or \"prod\"."
  }
}

variable "primary_region" {
  type        = string
  description = "US region that hosts the writer cluster at creation time."

  validation {
    condition     = can(regex("^us-[a-z]+-[0-9]$", var.primary_region))
    error_message = "primary_region must be a US AWS region, e.g. us-east-1."
  }
}

variable "secondary_region" {
  type        = string
  description = "Second US region that hosts the Aurora Global Database secondary cluster. Must differ from primary_region (enforced by a precondition on the global cluster)."

  validation {
    condition     = can(regex("^us-[a-z]+-[0-9]$", var.secondary_region))
    error_message = "secondary_region must be a US AWS region, e.g. us-west-2."
  }
}

variable "database_name" {
  type        = string
  description = "Initial database created in the primary cluster."
  default     = "app"

  validation {
    condition     = can(regex("^[a-z][a-z0-9_]{0,62}$", var.database_name))
    error_message = "database_name must start with a lowercase letter and contain only lowercase letters, digits and underscores."
  }
}

variable "master_username" {
  type        = string
  description = "Master user name. The password is generated by RDS and stored in Secrets Manager in the primary region; applications should use IAM authentication instead."
  default     = "dbadmin"

  validation {
    condition     = can(regex("^[a-z][a-z0-9_]{0,15}$", var.master_username))
    error_message = "master_username must be 1-16 characters, start with a letter, and use only lowercase letters, digits and underscores."
  }
}

variable "engine_version" {
  type        = string
  description = "Aurora PostgreSQL engine version. Major version selects the parameter group family."
  default     = "16.6"

  validation {
    condition     = can(regex("^1[4-7]\\.", var.engine_version))
    error_message = "engine_version must be an Aurora PostgreSQL 14.x to 17.x version string, e.g. 16.6."
  }
}

variable "instance_class" {
  type        = string
  description = "Instance class for every writer and reader instance in both regions."
  default     = "db.r6g.large"
}

variable "instance_count_per_region" {
  type        = number
  description = "Instances per regional cluster. At least 2 so that a single instance failure does not take the regional cluster down. Aurora allows up to 15."
  default     = 2

  validation {
    condition     = var.instance_count_per_region >= 2 && var.instance_count_per_region <= 15
    error_message = "instance_count_per_region must be between 2 and 15."
  }
}

variable "backup_retention_days" {
  type        = number
  description = "Automated backup retention in days. Point-in-time recovery is available across this window."
  default     = 35

  validation {
    condition     = var.backup_retention_days >= 7 && var.backup_retention_days <= 35
    error_message = "backup_retention_days must be between 7 and 35."
  }
}

variable "deletion_protection" {
  type        = bool
  description = "Protects the global cluster and both regional clusters from deletion. Leave enabled for production."
  default     = true
}

variable "log_retention_days" {
  type        = number
  description = "CloudWatch Logs retention for the PostgreSQL log of each regional cluster."
  default     = 365

  validation {
    condition     = contains([1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, 1096, 1827, 2192, 2557, 2922, 3288, 3653], var.log_retention_days)
    error_message = "log_retention_days must be a value CloudWatch Logs accepts, e.g. 90, 365."
  }
}

variable "kms_deletion_window_days" {
  type        = number
  description = "Waiting period before a regional KMS key is deleted."
  default     = 30

  validation {
    condition     = var.kms_deletion_window_days >= 7 && var.kms_deletion_window_days <= 30
    error_message = "kms_deletion_window_days must be between 7 and 30."
  }
}

variable "allowed_cidr_blocks" {
  type        = list(string)
  description = "IPv4 CIDRs allowed to connect on TCP 5432 in each region. Prefer allowed_security_group_ids."
  default     = []
}

variable "allowed_security_group_ids" {
  type        = list(string)
  description = "Security groups (in the regional VPC) allowed to connect on TCP 5432, typically the EKS node or pod security groups for that region."
  default     = []
}

variable "iam_db_user" {
  type        = string
  description = "Database user that application roles authenticate as with IAM. The user must be created in PostgreSQL and granted rds_iam."
  default     = "app"

  validation {
    condition     = can(regex("^[a-z][a-z0-9_]{0,62}$", var.iam_db_user))
    error_message = "iam_db_user must be a valid PostgreSQL role name."
  }
}

variable "app_iam_role_names" {
  type        = list(string)
  description = "Names of existing IAM roles (for example the EKS IRSA roles of the service) that receive rds-db:connect on the IAM database user in both regions."
  default     = []
}

variable "writer_region" {
  type        = string
  description = "Which regional cluster the writer DNS record points at: \"primary\" or \"secondary\". Change this to \"secondary\" after promoting the secondary cluster (see README)."
  default     = "primary"

  validation {
    condition     = contains(["primary", "secondary"], var.writer_region)
    error_message = "writer_region must be \"primary\" or \"secondary\"."
  }
}

variable "dns" {
  type = object({
    zone_id     = string
    record_name = string
  })
  description = "Optional private Route 53 hosted zone and record name (FQDN) for a stable writer CNAME. Null disables the record."
  default     = null
}

variable "secondary_region_alarm_actions" {
  type        = list(string)
  description = "SNS topic ARNs (in the secondary region) notified when replication lag to the secondary cluster exceeds the threshold."
  default     = []
}

variable "tags" {
  type        = map(string)
  description = "Additional tags applied to all resources."
  default     = {}
}
