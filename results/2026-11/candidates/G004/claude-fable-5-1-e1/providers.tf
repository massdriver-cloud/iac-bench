# Two regional providers: one per side of the Aurora Global Database.
# Credentials are taken from the environment (IAM role / env vars / profile).

provider "aws" {
  alias  = "primary"
  region = var.primary_region

  default_tags {
    tags = local.common_tags
  }
}

provider "aws" {
  alias  = "secondary"
  region = var.secondary_region

  default_tags {
    tags = local.common_tags
  }
}
