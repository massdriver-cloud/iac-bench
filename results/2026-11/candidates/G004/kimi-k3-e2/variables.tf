# ---------------------------------------------------------------------------
# Service-specific settings — the platform team fills these in per service.
# ---------------------------------------------------------------------------

variable "name" {
  description = "Name of the service/database (e.g. \"checkout\"). Used as the base for every resource identifier. 1-24 chars: lowercase letters, digits, hyphens; must start with a letter."
  type        = string
  nullable    = false

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{0,23}$", var.name))
    error_message = "name must be 1-24 characters of lowercase letters, digits and hyphens, starting with a letter (it becomes part of RDS identifiers and the initial database name)."
  }
}

variable "environment" {
  description = "Which environment this database serves. The module discovers the network team's VPC named \"apps-<environment>\" in each region."
  type        = string
  nullable    = false

  validation {
    condition     = contains(["staging", "prod"], var.environment)
    error_message = "environment must be \"staging\" or \"prod\" (the network team provides apps-staging and apps-prod VPCs)."
  }
}

# ---------------------------------------------------------------------------
# Regions / topology
# ---------------------------------------------------------------------------

variable "primary_region" {
  description = "AWS region hosting the writer (primary) cluster."
  type        = string
  default     = "us-east-1"
}

variable "secondary_region" {
  description = "AWS region hosting the standby (secondary) cluster. Must be a different region from primary_region."
  type        = string
  default     = "us-west-2"
}

variable "primary_instance_count" {
  description = "Number of Aurora instances in the primary region (writer + readers). 2 or more gives in-region, multi-AZ failover."
  type        = number
  default     = 2

  validation {
    condition     = var.primary_instance_count >= 1 && var.primary_instance_count <= 15
    error_message = "primary_instance_count must be between 1 and 15."
  }
}

variable "secondary_instance_count" {
  description = "Number of Aurora instances in the secondary region. At least 1 keeps a warm reader so a regional switchover completes in minutes."
  type        = number
  default     = 1

  validation {
    condition     = var.secondary_instance_count >= 1 && var.secondary_instance_count <= 15
    error_message = "secondary_instance_count must be between 1 and 15."
  }
}

variable "global_write_forwarding" {
  description = "Let the secondary cluster forward writes to the primary region (Aurora global write forwarding)."
  type        = bool
  default     = false
}

# ---------------------------------------------------------------------------
# Engine
# ---------------------------------------------------------------------------

variable "engine_version" {
  description = "Aurora PostgreSQL engine version (major.minor, e.g. \"16.6\"). Applied to the global cluster and all member clusters/instances."
  type        = string
  default     = "16.6"

  validation {
    condition     = can(regex("^[0-9]+\\.[0-9]+$", var.engine_version))
    error_message = "engine_version must be a major.minor version string such as \"16.6\"."
  }
}

variable "instance_class" {
  description = "Instance class for all Aurora instances. Aurora global databases require a memory-optimized class (db.r5/r6g/r6i/r7g/x2g families or better; burstable db.t* classes are not supported)."
  type        = string
  default     = "db.r6g.large"
}

variable "database_name" {
  description = "Name of the initial database to create. Defaults to the service name with hyphens replaced by underscores."
  type        = string
  default     = null
}

variable "port" {
  description = "TCP port the clusters listen on."
  type        = number
  default     = 5432

  validation {
    condition     = var.port >= 1150 && var.port <= 65535
    error_message = "port must be between 1150 and 65535."
  }
}

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------

variable "master_username" {
  description = "Master username. The master password is generated by RDS and stored in AWS Secrets Manager (break-glass only; applications should use IAM database authentication)."
  type        = string
  default     = "dbadmin"

  validation {
    condition     = can(regex("^[a-zA-Z][a-zA-Z0-9_]{0,62}$", var.master_username))
    error_message = "master_username must start with a letter and contain only letters, digits and underscores."
  }
}

variable "master_password" {
  description = "Optional externally-managed master password. Leave null (recommended) to have RDS generate and manage the password in Secrets Manager."
  type        = string
  default     = null
  sensitive   = true
}

# ---------------------------------------------------------------------------
# Networking / access
# ---------------------------------------------------------------------------

variable "additional_allowed_cidr_blocks" {
  description = "Extra CIDR blocks allowed to reach PostgreSQL in both regions, on top of each region's VPC CIDR (which already covers the EKS services)."
  type        = list(string)
  default     = []
}

variable "primary_allowed_security_group_ids" {
  description = "Security group IDs in the primary region whose members may reach PostgreSQL (e.g. EKS node groups)."
  type        = list(string)
  default     = []
}

variable "secondary_allowed_security_group_ids" {
  description = "Security group IDs in the secondary region whose members may reach PostgreSQL (e.g. EKS node groups)."
  type        = list(string)
  default     = []
}

variable "database_subnet_tag_key" {
  description = "Tag key marking the private database subnets created by the network team."
  type        = string
  default     = "tier"
}

variable "database_subnet_tag_value" {
  description = "Tag value marking the private database subnets created by the network team."
  type        = string
  default     = "database"
}

variable "primary_vpc_id" {
  description = "Override: VPC ID in the primary region. When null, the VPC tagged Name = \"apps-<environment>\" is discovered."
  type        = string
  default     = null
}

variable "secondary_vpc_id" {
  description = "Override: VPC ID in the secondary region. When null, the VPC tagged Name = \"apps-<environment>\" is discovered."
  type        = string
  default     = null
}

variable "primary_database_subnet_ids" {
  description = "Override: explicit database subnet IDs in the primary region. When null, subnets tagged tier=database in the primary VPC are used."
  type        = list(string)
  default     = null
}

variable "secondary_database_subnet_ids" {
  description = "Override: explicit database subnet IDs in the secondary region. When null, subnets tagged tier=database in the secondary VPC are used."
  type        = list(string)
  default     = null
}

# ---------------------------------------------------------------------------
# Backup / maintenance / protection
# ---------------------------------------------------------------------------

variable "backup_retention_period" {
  description = "Days to retain automated backups (point-in-time restore window)."
  type        = number
  default     = 14

  validation {
    condition     = var.backup_retention_period >= 1 && var.backup_retention_period <= 35
    error_message = "backup_retention_period must be between 1 and 35 days."
  }
}

variable "preferred_backup_window" {
  description = "Daily UTC backup window (hh24:mi-hh24:mi). Must not overlap the maintenance window."
  type        = string
  default     = "06:00-07:00"
}

variable "preferred_maintenance_window" {
  description = "Weekly UTC maintenance window (ddd:hh24:mi-ddd:hh24:mi)."
  type        = string
  default     = "sun:08:00-sun:09:00"
}

variable "deletion_protection" {
  description = "Protect the clusters from deletion. Keep true for production."
  type        = bool
  default     = true
}

variable "skip_final_snapshot" {
  description = "Skip the final snapshot when a cluster is destroyed. Keep false for anything holding data you care about."
  type        = bool
  default     = false
}

variable "apply_immediately" {
  description = "Apply cluster/instance modifications immediately instead of during the maintenance window."
  type        = bool
  default     = false
}

variable "auto_minor_version_upgrade" {
  description = "Let AWS apply minor engine upgrades during maintenance windows."
  type        = bool
  default     = true
}

# ---------------------------------------------------------------------------
# Observability / tuning (module-owned defaults, overridable)
# ---------------------------------------------------------------------------

variable "monitoring_interval" {
  description = "Enhanced monitoring collection interval in seconds (0 to disable)."
  type        = number
  default     = 60

  validation {
    condition     = contains([0, 1, 5, 10, 15, 30, 60], var.monitoring_interval)
    error_message = "monitoring_interval must be one of 0, 1, 5, 10, 15, 30, 60."
  }
}

variable "performance_insights_retention_period" {
  description = "Performance Insights retention in days: 7 (free tier) or 731 (2 years); AWS also accepts monthly multiples of 31."
  type        = number
  default     = 731

  validation {
    condition     = var.performance_insights_retention_period == 7 || var.performance_insights_retention_period == 731 || (var.performance_insights_retention_period % 31 == 0 && var.performance_insights_retention_period >= 31 && var.performance_insights_retention_period <= 731)
    error_message = "performance_insights_retention_period must be 7, 731, or a multiple of 31 up to 731."
  }
}

variable "cloudwatch_log_retention_in_days" {
  description = "Retention (days) for the exported PostgreSQL logs in CloudWatch Logs."
  type        = number
  default     = 365
}

variable "cluster_parameter_group_parameters" {
  description = "Additional/override cluster parameter group settings. Entries are merged over the module's production defaults (TLS enforcement, connection/DDL auditing, slow-query logging, pg_stat_statements); an entry whose name matches a default replaces it."
  type = list(object({
    name         = string
    value        = string
    apply_method = optional(string, "immediate")
  }))
  default = []
}

# ---------------------------------------------------------------------------
# Tags
# ---------------------------------------------------------------------------

variable "tags" {
  description = "Additional tags applied to every resource (merged over the module's defaults)."
  type        = map(string)
  default     = {}
}
