resource "null_resource" "{{ resource_prefix }}_a" {
  triggers = {
    peer = null_resource.{{ resource_prefix }}_b.id
    role = "primary"
  }
}

resource "null_resource" "{{ resource_prefix }}_b" {
  triggers = {
    peer = null_resource.{{ resource_prefix }}_a.id
    role = "replica"
  }
}
{% for i in range(extra_decoys) %}

resource "null_resource" "decoy_{{ i }}" {
  triggers = {
    index = "{{ i }}"
  }
}
{% endfor %}
