provider "aws" {
  region = "us-east-1"

  default_tags {
    tags = {
      iacbench = "true"
      fixture  = "F101"
    }
  }
}

data "aws_caller_identity" "current" {}

resource "random_id" "{{ resource_prefix }}_suffix" {
  byte_length = 4
}

resource "aws_s3_bucket" "{{ resource_prefix }}_assets" {
  bucket        = "iacbench-{{ resource_prefix }}-assets-${random_id.{{ resource_prefix }}_suffix.hex}"
  force_destroy = true
}

resource "aws_s3_bucket_policy" "{{ resource_prefix }}_assets" {
  bucket = aws_s3_bucket.{{ resource_prefix }}_assets.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "AllowAccountRead"
        Effect = "Allow"
        Principal = {
          AWS = data.aws_caller_identity.current.account_id
        }
        Action   = ["s3:GetObject"]
        Resource = "arn:aws:s3:::iacbench-{{ resource_prefix }}-assets/*"
      }
    ]
  })
}
